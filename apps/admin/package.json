{
  "name": "@kabootar/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "ng build",
    "build:cf": "node scripts/write-cloudflare-env.mjs && ng build --configuration=cloudflare",
    "dev": "ng serve --port 4200",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "clean": "rimraf dist .angular coverage"
  },
  "dependencies": {
    "@angular/animations": "^19.2.3",
    "@angular/common": "^19.2.3",
    "@angular/compiler": "^19.2.3",
    "@angular/core": "^19.2.3",
    "@angular/forms": "^19.2.3",
    "@angular/platform-browser": "^19.2.3",
    "@angular/platform-browser-dynamic": "^19.2.3",
    "@angular/router": "^19.2.3",
    "@kabootar/shared": "workspace:*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular-eslint/builder": "19.8.1",
    "@angular/cli": "^19.2.4",
    "@angular/compiler-cli": "^19.2.3",
    "@types/jasmine": "^5.1.7",
    "jasmine-core": "^5.6.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.7.3"
  }
}
