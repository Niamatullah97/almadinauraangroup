# API Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://kabootar:kabootar_secret@localhost:5432/kabootar?schema=public
DIRECT_URL=postgresql://kabootar:kabootar_secret@localhost:5432/kabootar?schema=public

# Default Super Admin (after seed): superadmin@kabootar.local / SuperAdmin@123
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=log

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
ADMIN_APP_URL=http://localhost:4200

# Use "supabase" in production. Service role credentials must remain API-only.
STORAGE_DRIVER=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# SUPABASE_STORAGE_BUCKET=kabootar
