# Kabootar API — Hostinger Node Web App
# Configure these values in hPanel. Never commit real credentials.

NODE_ENV=production
PORT=3000

# Supabase transaction pooler (port 6543) for application traffic.
DATABASE_URL=postgresql://postgres.PROJECT_REF:almadinauraangroup_123@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase session/direct connection (port 5432) for Prisma migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:almadinauraangroup_123@REGION.pooler.supabase.com:5432/postgres

JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
ADMIN_APP_URL=https://admin.yourdomain.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=log

STORAGE_DRIVER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=kabootar
