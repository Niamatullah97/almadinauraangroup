# =============================================================================
# Kabootar — Production Environment Template
# Copy to .env on the server and replace all placeholder values.
# NEVER commit real secrets to version control.
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=kabootar_prod
POSTGRES_PASSWORD=almadinauraangroup_123
POSTGRES_DB=kabootar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kabootar_prod:almadinauraangroup_123@postgres:5432/kabootar?schema=public
DIRECT_URL=postgresql://kabootar_prod:almadinauraangroup_123@postgres:5432/kabootar?schema=public
STORAGE_DRIVER=local

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3000
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=https://admin.almadinauraangroup.com,https://almadinauraangroup.com,https://www.almadinauraangroup.com
ADMIN_APP_URL=https://admin.almadinauraangroup.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=log

# Run seed once on first deploy only
RUN_DB_SEED=false

# ── Public website (Next.js) ─────────────────────────────────────────────────
WEB_PORT=3001
NEXT_PUBLIC_API_URL=https://api.almadinauraangroup.com/api/v1
NEXT_PUBLIC_SITE_URL=https://almadinauraangroup.com
NEXT_PUBLIC_UPLOADS_URL=https://abeewdprilovdbaynbdh.supabase.co/storage/v1/object/public/kabootar
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_CONTACT_EMAIL=info@almadinauraangroup.com
NEXT_PUBLIC_CONTACT_PHONE=+923001234567

# ── Reverse proxy / TLS (Hostinger VPS) ──────────────────────────────────────
DOMAIN=almadinauraangroup.com
ADMIN_DOMAIN=admin.almadinauraangroup.com
SSL_EMAIL=admin@almadinauraangroup.com
