# =============================================================================
# Kabootar — Production Environment Template
# Copy to .env on the server and replace all placeholder values.
# NEVER commit real secrets to version control.
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=kabootar_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=kabootar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kabootar_prod:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/kabootar?schema=public
DIRECT_URL=postgresql://kabootar_prod:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/kabootar?schema=public
STORAGE_DRIVER=local

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3000
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com
ADMIN_APP_URL=https://admin.yourdomain.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=log

# Run seed once on first deploy only
RUN_DB_SEED=false

# ── Public website (Next.js) ─────────────────────────────────────────────────
WEB_PORT=3001
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_UPLOADS_URL=https://yourdomain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_CONTACT_EMAIL=info@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=+923001234567

# ── Reverse proxy / TLS (Hostinger VPS) ──────────────────────────────────────
DOMAIN=yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
SSL_EMAIL=admin@yourdomain.com
